# Chat endpoint the assistant page posts to. The app is a static export, so this
# value is inlined at build time and the request goes straight from the browser
# to the workflow — the endpoint must allow CORS from the site's origin, and it
# must not carry any secret. Leave it unset to run the chat in demo mode.
NEXT_PUBLIC_CHAT_ENDPOINT=https://drive.8n.ai/webhook/ipattaya-chat
